{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storystable:generation-packet",
  "title": "GenerationPacket",
  "description": "Immutable render request after submission. Effective values are adapter-generated and reflect what was actually submitted, not what was requested.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "urn:storystable:common#/$defs/schemaVersion" },
    "id": { "$ref": "urn:storystable:common#/$defs/objectId" },
    "type": { "const": "generation_packet" },
    "shot_id": { "$ref": "urn:storystable:common#/$defs/objectId" },
    "created_at": { "$ref": "urn:storystable:common#/$defs/isoDateTime" },
    "source_revision_hash": { "$ref": "urn:storystable:common#/$defs/sha256" },
    "compiler": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["t2va", "i2va", "fl2va", "l2va", "ref2va"] },
        "model_family": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "adapter_version", "mode"],
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "workflow_hash": { "$ref": "urn:storystable:common#/$defs/sha256" }
      },
      "required": ["adapter_id", "adapter_version", "workflow_hash"],
      "additionalProperties": false
    },
    "requested": {
      "type": "object",
      "properties": {
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "aspect_ratio": { "type": "string", "pattern": "^\\d+:\\d+$" }
      },
      "required": ["duration_seconds"],
      "additionalProperties": false
    },
    "effective": {
      "type": "object",
      "properties": {
        "frames": { "type": "integer", "minimum": 1 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["frames", "duration_seconds", "width", "height"],
      "additionalProperties": false
    },
    "references": {
      "type": "object",
      "properties": {
        "pictures": { "$ref": "#/$defs/orderedInputs" },
        "videos": { "$ref": "#/$defs/orderedInputs" },
        "audios": { "$ref": "#/$defs/orderedInputs" }
      },
      "required": ["pictures", "videos", "audios"],
      "additionalProperties": false
    },
    "compiled_prompt": { "type": "string" },
    "settings": { "type": "object" }
  },
  "required": [
    "schema_version",
    "id",
    "type",
    "shot_id",
    "created_at",
    "source_revision_hash",
    "compiler",
    "renderer",
    "workflow",
    "requested",
    "effective",
    "references",
    "compiled_prompt"
  ],
  "additionalProperties": false,
  "$defs": {
    "orderedInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": { "type": "string", "minLength": 1 },
          "asset_id": { "$ref": "urn:storystable:common#/$defs/objectId" },
          "roles": {
            "type": "array",
            "items": { "$ref": "urn:storystable:common#/$defs/referenceRole" },
            "minItems": 1
          }
        },
        "required": ["tag", "asset_id", "roles"],
        "additionalProperties": false
      }
    }
  }
}
