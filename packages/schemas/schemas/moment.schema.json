{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storystable:moment",
  "title": "Moment",
  "description": "A narrative/visual unit the audience should experience, existing before any shot. May be generated from beats, reordered, merged, or discarded without rewriting the screenplay.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "urn:storystable:common#/$defs/schemaVersion" },
    "id": { "$ref": "urn:storystable:common#/$defs/objectId" },
    "type": { "const": "moment" },
    "scene_id": { "$ref": "urn:storystable:common#/$defs/objectId" },
    "order": { "type": "integer", "minimum": 0 },
    "status": { "type": "string", "enum": ["proposed", "developing", "approved", "rejected"] },
    "purpose": { "type": "string" },
    "required_information": { "type": "array", "items": { "type": "string" } },
    "emotional_turn": {
      "type": "object",
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" }
      },
      "additionalProperties": false
    },
    "state_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "from": { "type": ["string", "number", "boolean", "null"] },
          "to": { "type": ["string", "number", "boolean", "null"] }
        },
        "required": ["path", "to"],
        "additionalProperties": false
      }
    },
    "visual_options": { "type": "array", "items": { "type": "string" } },
    "shot_ids": {
      "type": "array",
      "items": { "$ref": "urn:storystable:common#/$defs/objectId" }
    }
  },
  "required": ["schema_version", "id", "type", "scene_id", "order", "status", "purpose"],
  "additionalProperties": false
}
