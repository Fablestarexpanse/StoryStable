{
  "name": "storystable",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native animation & worldbuilding production OS",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "schema:validate": "npm run validate --workspace packages/schemas",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run schema:validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.11",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
