{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoryStable",
  "version": "0.1.0",
  "identifier": "com.fablestarexpanse.storystable",
  "build": {
    "beforeDevCommand": "node ../../../scripts/dev-web.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StoryStable",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
